[Unit]
Description=DragonTCP Admin Panel
After=network.target dragontcp.service
Requires=dragontcp.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/tcp
EnvironmentFile=-/etc/default/dragontcp-panel
ExecStart=/usr/bin/python3 /opt/tcp/painel.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
